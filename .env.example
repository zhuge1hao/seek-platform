QA_STREAM_ENABLED=true
QA_STREAM_HEARTBEAT_SECONDS=15
QA_STREAM_MAX_SECONDS=120

BGE_SMALL_ZH_MODEL_PATH=./models/bge-small-zh
RAG_SQLITE_PATH=apps/api/runtime/rag/rag.sqlite3
RAG_BACKEND=sqlite
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.25
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100

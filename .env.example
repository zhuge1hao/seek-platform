APP_NAME=meizhaiseek-platform
API_SERVICE_NAME=meizhaiseek-api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

VIDEO_UPLOAD_DIR=E:/USE/codexhome/fenge/videos/test

LOCAL_AGENT_MODE=http
LOCAL_AGENT_BASE_URL=http://127.0.0.1:8001
LOCAL_AGENT_RUN_ENDPOINT=/run
LOCAL_AGENT_CLI_COMMAND=
LOCAL_AGENT_TIMEOUT_SECONDS=1800
LOCAL_AGENT_OUTPUT_DIR=E:/USE/codexhome/fenge/outputs
AGENT_CONNECTOR_STORE_PATH=apps/api/runtime/connectors/agent_connectors.json
LOCAL_AGENT_PAYLOAD_STYLE=protocol
LOCAL_AGENT_DEFAULT_SESSION_ID=
LOCAL_AGENT_VIDEO_SCRIPT_SESSION_ID=019dd824-f4bb-7273-8ac3-6e19b195ff82

AGENT_RUN_STORE_DIR=apps/api/runtime/agent_runs
AGENT_CONFIG_STORE_PATH=apps/api/runtime/configs/agent_configs.json
SKILL_TEMPLATE_STORE_PATH=apps/api/runtime/configs/skill_templates.json
FILE_STORE_PATH=apps/api/runtime/files/files.json
DATASET_STORE_ROOT=apps/api/runtime/users
RUNTIME_BACKUP_DIR=apps/api/runtime/backups
RUNTIME_CORRUPTED_DIR=apps/api/runtime/corrupted
DEBUG_PAYLOAD_DIR=apps/api/runtime/debug_payloads
FILE_PREVIEW_CACHE_DIR=apps/api/runtime/file_previews
STALE_RUN_TIMEOUT_MINUTES=120

MEIZHAISEEK_ADMIN_USERNAME=admin
MEIZHAISEEK_ADMIN_INITIAL_PASSWORD=replace-with-strong-initial-admin-password
AUTH_TOKEN_SECRET=replace-with-32-plus-char-random-secret
AUTH_TOKEN_EXPIRE_HOURS=168
AUTH_USER_STORE_PATH=apps/api/runtime/auth/users.json
AUDIT_LOG_PATH=apps/api/runtime/audit/audit_logs.jsonl

APP_STORAGE_BACKEND=sqlite
APP_ENV=development
APP_DB_BACKEND=sqlite
APP_DATABASE_URL=
APP_DB_POOL_SIZE=5
APP_DB_MAX_OVERFLOW=5
APP_SQLITE_PATH=apps/api/runtime/app/meizhaiseek.sqlite3
APP_SQLITE_AUTO_MIGRATE=true
APP_JSON_LEGACY_BACKUP_DIR=apps/api/runtime/legacy_json_backups
APP_LEGACY_JSON_FALLBACK=false

CACHE_BACKEND=memory
EVENT_BACKEND=memory
TASK_QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0
API_MAX_INFLIGHT_REQUESTS=200
SSE_MAX_CONNECTIONS_PER_INSTANCE=200
LOGIN_RATE_LIMIT_PER_WINDOW=60
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

DEEPSEEK_MAX_CONCURRENCY=20
VIDEO_AGENT_MAX_CONCURRENCY=2
DATASET_JOB_MAX_CONCURRENCY=4
DOCUMENT_INGEST_MAX_CONCURRENCY=4

ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_SHARED_ROOT=apps/api/runtime/artifacts
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=meizhaiseek-artifacts
S3_REGION=
S3_SECURE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
